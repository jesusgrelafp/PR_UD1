// 1. Mostrar los 20 primeros números naturales pares
Algoritmo primeros20Pares
    Definir contador, numeroPar Como Entero
    
    contador <- 0
    
    Mientras contador < 20 Hacer
        numeroPar <- (contador + 1) * 2
        Escribir numeroPar
        contador <- contador + 1
    FinMientras
FinAlgoritmo