Algoritmo esMultiplo
    Definir numN, numM Como Entero
    
    Escribir "Introduce N y M"
    Leer numN, numM
    
    Si numN % numM = 0 Entonces
        Escribir "El número ", numN, " es divisible entre ", numM
    Sino
        Escribir "El número ", numN, " NO es divisible entre ", numM
    FinSi
FinAlgoritmo