Algoritmo tablaMultiplicar
    Definir num, contador Como Entero
    
    Escribir "Introduce un número:"
    Leer num
    
    contador <- 0
    
    Mientras contador <= 10 Hacer
        Escribir num, " x ", contador, " = ", num * contador
        contador <- contador + 1
    FinMientras
FinAlgoritmo